# ============================================================================
# 本地私密配置示例
# ----------------------------------------------------------------------------
# 用法：把本文件复制为同目录下的 application-local.yml，填入本机真实值。
#      application-local.yml 已被 .gitignore 忽略，不会提交到版本库。
# 载入：application.yml 默认激活 dev,local；也可显式指定 --spring.profiles.active=dev,local。
# ============================================================================

spring:
  datasource:
    # 可将 127.0.0.1 换为虚拟机地址；先确认 3306 端口和 MySQL 远程访问权限。
    # 建库脚本见 interview-ai/sql/interview_ai.sql。
    url: jdbc:mysql://127.0.0.1:3306/interview_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: ""

  security:
    oauth2:
      client:
        registration:
          gitee:
            # Gitee 第三方登录应用凭证：https://gitee.com/oauth/applications
            # 留空则该登录入口不可用，不影响账号密码登录与其余功能。
            client-id: ""
            client-secret: ""

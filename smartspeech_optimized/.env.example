# ============================================================================
# 智能体模拟面试系统 - 环境变量示例
# 使用方法：复制本文件为 .env，填入真实值后保存。.env 不会被提交到版本库。
# ============================================================================

# ---------------------------------------------------------------- 大模型 ----
# DeepSeek 开放平台申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=90
# 送入大模型的最近对话条数（越大越连贯，消耗的 token 越多）
CHAT_CONTEXT_MESSAGES=20

# ---------------------------------------------------------------- 简历 ----
# 单个简历文件大小上限（字节），默认 8 MB
MAX_RESUME_SIZE=8388608
# 允许写入简历文本的最大字符数
RESUME_MAX_EXTRACTED_CHARS=50000
# 每次发送给大模型的简历文本最大字符数
RESUME_PROMPT_MAX_CHARS=24000

# ------------------------------------------------------------ 面试流程 ----
# 单轮面试最多问题数；达到上限后由用户选择评估或开启下一轮
INTERVIEW_QUESTION_LIMIT=12

# ------------------------------------------------------------ 语音识别 ----
# Whisper 模型规格：tiny / base / small / medium / large
# 规格越大越准，但首次下载体积更大、CPU 推理更慢
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu

# ------------------------------------------------------------ 语音合成 ----
DEFAULT_TTS_VOICE=zh-CN-YunxiNeural
TTS_TIMEOUT_SECONDS=35

# ---------------------------------------------------------- 视觉分析 ----
# 每秒送入后端分析的画面帧数（前端可选 2 / 3 / 4）
DEFAULT_VISION_FPS=3
MAX_VISION_FPS=8
# 指标快照间隔（秒），用于生成趋势曲线
SNAPSHOT_INTERVAL_SECONDS=2

# ------------------------------------------------------------ 人脸识别 ----
# 人脸特征距离阈值：越小越严格，建议 0.9 ~ 1.1
FACE_MATCH_THRESHOLD=1.0

# ---------------------------------------------------------------- 服务 ----
APP_HOST=127.0.0.1
APP_PORT=8765
FLASK_DEBUG=0
# 生产环境部署到 HTTPS 时改为 1，并配置 FLASK_SECRET_KEY
SESSION_COOKIE_SECURE=0
FLASK_SECRET_KEY=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
